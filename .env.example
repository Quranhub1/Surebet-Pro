# Copy to .env for local development. Never commit real credentials.

# Football data
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# AI providers (configure at least one)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
Z_AI_API_KEY=your_z_ai_api_key_here

# Optional news context
TAVILY_API_KEY=your_tavily_api_key_here

# Model configuration
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-8b-instant
DEEPSEEK_MODEL=deepseek-chat
Z_AI_MODEL=default

# Engine controls
MAX_MATCHES=100
PREDICTION_BATCH_SIZE=8
PREDICTION_BATCH_DELAY_MS=1500
FIXTURE_CACHE_TTL_MS=600000

# Optional provider weights
AI_WEIGHT_GEMINI=1
AI_WEIGHT_GROQ=1
AI_WEIGHT_DEEPSEEK=1
AI_WEIGHT_ZAI=1
